# The Dockerfile copies only what the build needs; this keeps the build context small,
# and keeps local artifacts and secrets out of it.
.git
.tmp
bin
data
web/dist
web/node_modules
# regenerated by the web build; inlang keeps only settings.json in git
web/src/paraglide
web/project.inlang/*
!web/project.inlang/settings.json

# secrets must never be sent to the builder
.env
.env.*

# tests don't affect the binary, so changing them shouldn't rebuild it
**/*_test.go
